<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/enterpriseauth.css">
    <title>Dashboard | EnterpriseAuth</title>
</head>
<body>
    <div class="horizontal-center">
        <div class="container">
            <div style="text-align: left;">
                <h1>Dashboard</h1>
                <p>View everything in one place.</p>
                <h2>Users</h2>
                <button onclick="newuser();">New user</button>
                <br>
                <br>
                <table>
                    <tr>
                        <th>Username</th>
                        <th>UID</th>
                        <th>Admin</th>
                        <th>HWID</th>
                        <td>Delete</td>
                    </tr>
                    <% users.forEach((user) => { %>
                        <tr>
                            <td><%= user.username %></td>
                            <td><%= user.id %></td>
                            <td><%= user.admin %></td>
                            <% if(user.hwid) { %>
                                <td class="set">Set</td>
                            <% } else { %>
                                <td class="unset">Unset</td>
                            <% } %>
                            <td><button onclick="deleteuser('<%= user.id %>')">Delete</button></td>
                        </tr>
                    <% }); %>
                </table>
            </div>
        </div>
    </div>
    <script>
      function deleteuser(id) {
        const confirm1 = confirm("Are you ABSOLUTELY CERTAIN that you want to delete this user?")
        if(confirm1 == false) return;
        // TODO: actually delete the user
        location.reload();
      }
    </script>
</body>
</html>
