<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/enterpriseauth.css">
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <title>Dashboard | EnterpriseAuth</title>
</head>
<body>
    <div class="horizontal-center">
        <div class="container">
            <div style="text-align: left;">
                <h1>Dashboard</h1>
                <p>View everything in one place.</p>
                <h2>Users</h2>
                <button onclick="newuser();">New user</button>
                <br>
                <br>
                <table>
                    <tr>
                        <th>Username</th>
                        <th>UID</th>
                        <th>Admin</th>
                        <th>HWID</th>
                        <td>Delete</td>
                    </tr>
                    <% users.forEach((user) => { %>
                        <tr>
                            <td><%= user.username %></td>
                            <td><%= user.id %></td>
                            <td>
                                <input
                                    type="checkbox"
                                    data-username="<%= user.username %>"
                                    <% if (user.admin) { %>
                                        checked
                                    <% } %>
                                >
                            </td>
                            <% if(user.hwid) { %>
                                <td>
                                    <span class="set">Set</span>
                                    <button style="transform: none !important;" onclick="resetHWID('<%= user.username %>')">
                                        Reset
                                    </button>
                                </td>
                            <% } else { %>
                                <td class="unset">Unset</td>
                            <% } %>
                            <td><button onclick="deleteuser('<%= user.username %>')">Delete</button></td>
                        </tr>
                    <% }); %>
                </table>
            </div>
        </div>
    </div>
    <script>
      async function deleteuser(username) {
        const confirm1 = confirm("Are you ABSOLUTELY CERTAIN that you want to delete this user?")
        if(confirm1 == false) return;
        try {
          const { data } = await axios.post("/api/delete-user", {
            username
          });
          location.reload();
        } catch(err) {
          alert(`Error: ${err.response.data.message}`)
        }
        location.reload();
      }

      async function newuser() {
        const username = prompt("What should their username be?");
        const password = prompt("What should their password be?")

        try {
          const { data } = await axios.post("/api/newuser", {
            username,
            password
          });
          location.reload();
        } catch(err) {
          alert(`Error: ${err.response.data.message}`)
        }
      }

      const checkboxes = document.querySelectorAll('input[type="checkbox"]');

      checkboxes.forEach((checkbox) => {
        checkbox.onchange = async (e) => {
          const username = e.target.getAttribute("data-username");
          const isAdmin = e.target.checked;
          try {
            const { data } = await axios.post("/api/change-perms", {
              username,
              admin: isAdmin
            });
            location.reload();
          } catch(err) {
            alert(`Error: ${err.response.data.message}`)
          }
        };
      });

      async function resetHWID(username) {
        try {
          const { data } = await axios.post("/api/reset-hwid", {
            username
          });
          location.reload();
        } catch(err) {
          alert(`Error: ${err.response.data.message}`)
        }
      }
    </script>
</body>
</html>
