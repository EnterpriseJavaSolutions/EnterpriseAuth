<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/enterpriseauth.css">
    <title>Sign In | EnterpriseAuth</title>
</head>
<body>
    <div class="center">
        <div class="container">
            <h1>Sign in</h1>
            <p>Sign in to use Enterprise Auth.</p>
            <form id="sign-in" class="flex-form">
                <input type="text" placeholder="Username">
                <input type="password" placeholder="Password">
                <button type="submit">Sign in</button>
            </form>
        </div>
    </div>
</body>
</html>
